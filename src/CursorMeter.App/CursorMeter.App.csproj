<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>CursorMeter.App</RootNamespace>
    <AssemblyName>CursorMeter</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\CursorMeter.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Product>CursorMeter</Product>
    <!-- This branch builds the Mainland edition: beta for Windows 10/11 with Start11 v1/v2 (experimental administrator mode). The stable Island edition lives on main. -->
    <Edition>Mainland</Edition>
    <Version>1.4.0-beta.3</Version>
    <DefineConstants>$(DefineConstants);MAINLAND</DefineConstants>
    <Description>Duas barras na barra de tarefas: Cursor Models e Other Models.</Description>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Edition</_Parameter1>
      <_Parameter2>$(Edition)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.23" />
    <!-- Same version Avalonia.FreeDesktop already brings in. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CursorMeter.Core\CursorMeter.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="CursorMeter" />
  </ItemGroup>
</Project>
