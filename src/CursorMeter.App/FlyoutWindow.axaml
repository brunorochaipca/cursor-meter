<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CursorMeter.App.FlyoutWindow"
        Title="CursorMeter"
        Width="320"
        SizeToContent="Height"
        SystemDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="Transparent"
        FontSize="12">
  <Border x:Name="Card"
          Background="#181818"
          BorderBrush="#33FFFFFF"
          BorderThickness="1"
          CornerRadius="8"
          Padding="16,14,16,14">
    <StackPanel>
      <TextBlock x:Name="DetailText"
                 MinHeight="40"
                 FontWeight="SemiBold"
                 Foreground="#ECEAE2"
                 TextWrapping="Wrap" />
      <TextBlock x:Name="SecondaryText"
                 MinHeight="18"
                 Margin="0,0,0,16"
                 Foreground="#B0ACA0"
                 TextWrapping="Wrap" />
      <StackPanel x:Name="SetupPanel" IsVisible="False" Spacing="10" Margin="0,0,0,16">
        <StackPanel Spacing="3">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Cursor (recomendado)" FontWeight="SemiBold" Foreground="#ECEAE2" />
            <TextBlock x:Name="CursorStatusText" Grid.Column="1" Foreground="#E07070" />
          </Grid>
          <TextBlock x:Name="CursorHintText" Foreground="#B0ACA0" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,3,0,0">
            <Button x:Name="OpenCursorButton" Content="Abrir o Cursor" />
            <Button x:Name="DownloadCursorButton" Content="Transferir o Cursor" />
          </StackPanel>
        </StackPanel>
        <Border Height="1" Background="#33FFFFFF" />
        <StackPanel Spacing="3">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Firefox" FontWeight="SemiBold" Foreground="#ECEAE2" />
            <TextBlock x:Name="FirefoxStatusText" Grid.Column="1" Foreground="#E07070" />
          </Grid>
          <TextBlock x:Name="FirefoxHintText" Foreground="#B0ACA0" TextWrapping="Wrap" />
          <TextBlock x:Name="FirefoxWarningText" Foreground="#E0B050" TextWrapping="Wrap" IsVisible="False" />
          <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
            <Button x:Name="OpenFirefoxButton" Content="Abrir cursor.com no Firefox" />
          </StackPanel>
        </StackPanel>
        <TextBlock Text="Outros navegadores, como o Edge e o Chrome, não são lidos."
                   Foreground="#80ECEAE2" FontSize="11" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="RefreshButton" Content="Atualizar" MinWidth="96" />
        <Button x:Name="DashboardButton" Content="Painel do Cursor" MinWidth="130" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
